generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  pinHash        String? // Optional for OAuth users until they set one
  securityAnswer String    @default("")
  theme          String    @default("midnight")
  xp             Int       @default(0)
  level          Int       @default(1)
  createdAt      DateTime  @default(now())

  accounts            Account[]
  sessions            Session[]
  projects            Project[]
  ownedGoals          Goal[]              @relation("OwnedGoals")
  sharedGoals         GoalParticipant[]
  checkIns            CheckIn[]
  sentNudges          Nudge[]             @relation("SentNudges")
  receivedNudges      Nudge[]             @relation("ReceivedNudges")
  sentConnections     PartnerConnection[] @relation("SentConnections")
  receivedConnections PartnerConnection[] @relation("ReceivedConnections")
  projectParticipation ProjectParticipant[]
  journalEntries      JournalEntry[]
  financeAccounts     FinanceAccount[]
  financeBudgets      FinanceBudget[]
  financeGoals        FinanceGoal[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  color       String
  deadline    DateTime?
  createdAt   DateTime  @default(now())

  goals        Goal[]               // Habits/Milestones linked to this project
  phases       ProjectPhase[]       // Strategic phases
  participants ProjectParticipant[] // Collaborators
}

model ProjectPhase {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  tasks ProjectTask[]
}

model ProjectTask {
  id          String   @id @default(cuid())
  phaseId     String
  phase       ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean  @default(false)
  order       Int      @default(0)
  assignedTo  String?  // Optional: User ID assigned to this task
  deadline    DateTime?
  createdAt   DateTime @default(now())
}

model ProjectParticipant {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String  @default("VIEWER") // "VIEWER" | "EDITOR"

  @@id([projectId, userId])
}

model Goal {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("OwnedGoals", fields: [ownerId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title String
  color String

  category String @default("HABIT") // "HABIT" | "MILESTONE"

  targetValue Int?
  unit        String?

  frequency    String  @default("DAILY") // "DAILY"|"WEEKDAYS"|"WEEKENDS"|"MON_WED_FRI"|"TUE_THU_SAT"|"WEEKLY"|"BIWEEKLY"|"MONTHLY"
  reminderTime String? // "HH:MM" 24h format, null = no reminder

  isActive   Boolean   @default(true)
  isPrivate  Boolean   @default(false)
  targetDate DateTime? // Specific deadline for MILESTONES
  createdAt  DateTime  @default(now())

  participants GoalParticipant[]
  checkIns     CheckIn[]
}

model GoalParticipant {
  goalId String
  userId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([goalId, userId])
}

model CheckIn {
  id     String @id @default(cuid())
  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date String // ISO date string "YYYY-MM-DD"

  status     String // "DONE" | "PARTIAL" | "MISSED"
  value      Int? // Numeric progress
  effort     Int? // 1-5 rating
  reflection String?

  createdAt DateTime @default(now())

  @@unique([goalId, userId, date])
}

model PartnerConnection {
  id          String   @id @default(cuid())
  requesterId String
  responderId String?
  requester   User     @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  responder   User?    @relation("ReceivedConnections", fields: [responderId], references: [id], onDelete: Cascade)
  status      String // "PENDING" | "APPROVED" | "REJECTED"
  token       String   @unique @default(cuid())
  createdAt   DateTime @default(now())
}

model Nudge {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  sender     User     @relation("SentNudges", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedNudges", fields: [receiverId], references: [id], onDelete: Cascade)
  reaction   String? // Optional emoji reaction (🔥, 💙, 🙌)
  createdAt  DateTime @default(now())
  read       Boolean  @default(false)
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinanceAccount {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  currency     String               // "NGN" | "USD" | "ADA"
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions FinanceTransaction[]

  @@index([userId])
}

model FinanceTransaction {
  id                 String          @id // Client-generated UUID
  userId             String
  accountId          String
  account            FinanceAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount             Float           // Negative for expense, positive for income
  type               String          // "INCOME" | "EXPENSE" | "TRANSFER"
  category           String          // e.g. "Food & Feeding", "Transport", "Gifts"
  note               String?
  date               DateTime
  recipientAccountId String?         // Optional (for transfers)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId])
  @@index([accountId])
}

model FinanceBudget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  limit     Float
  currency  String   // e.g. "NGN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, currency])
}

model FinanceGoal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetAmount Float
  savedAmount  Float     @default(0)
  currency     String    // e.g. "NGN"
  targetDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}
