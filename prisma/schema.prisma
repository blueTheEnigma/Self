generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  pinHash        String?   // Optional for OAuth users until they set one
  securityAnswer String    @default("")
  theme          String    @default("midnight")
  xp             Int       @default(0)
  level          Int       @default(1)
  createdAt      DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  goals         Goal[]
  sentNudges    Nudge[]             @relation("SentNudges")
  receivedNudges Nudge[]             @relation("ReceivedNudges")
  sentConnections PartnerConnection[] @relation("SentConnections")
  receivedConnections PartnerConnection[] @relation("ReceivedConnections")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Goal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String    // "NAMED" | "UNNAMED"
  title        String?   // Only for NAMED
  color        String    // Hex color string
  frequency    String    @default("DAILY") // "DAILY"|"WEEKDAYS"|"WEEKENDS"|"MON_WED_FRI"|"TUE_THU_SAT"|"WEEKLY"|"BIWEEKLY"|"MONTHLY"
  reminderTime String?   // "HH:MM" 24h format, null = no reminder
  isActive     Boolean   @default(true)
  isPrivate    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  checkIns     CheckIn[]
}

model CheckIn {
  id         String   @id @default(cuid())
  goalId     String
  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date       String   // ISO date string "YYYY-MM-DD"
  status     String   // "DONE" | "MISSED"
  reflection String?  // Optional reflection or "win"
  createdAt  DateTime @default(now())

  @@unique([goalId, date])
}

model PartnerConnection {
  id          String   @id @default(cuid())
  requesterId String
  responderId String?
  requester   User     @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  responder   User?    @relation("ReceivedConnections", fields: [responderId], references: [id], onDelete: Cascade)
  status      String   // "PENDING" | "APPROVED" | "REJECTED"
  token       String   @unique @default(cuid())
  createdAt   DateTime @default(now())
}

model Nudge {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  sender     User     @relation("SentNudges", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedNudges", fields: [receiverId], references: [id], onDelete: Cascade)
  reaction   String?  // Optional emoji reaction (🔥, 💙, 🙌)
  createdAt  DateTime @default(now())
  read       Boolean  @default(false)
}
